PORT=5000
MONGODB_URI=mongodb+srv://fxwallet70_db_user:FXwallet70301043@cluster0.bwihsjp.mongodb.net/fxwallet?retryWrites=true&w=majority&appName=Cluster0
# Or use an Atlas cluster connection string, e.g.:
