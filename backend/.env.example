# Copy this file to .env and fill in your values.
# MONGODB_URI and JWT_SECRET are required.

PORT=5000
MONGODB_URI=mongodb://<dbuser>:<password>@<shard-00-00>.<cluster>.mongodb.net:27017,<shard-00-01>.<cluster>.mongodb.net:27017,<shard-00-02>.<cluster>.mongodb.net:27017/<dbname>?retryWrites=true&w=majority&authSource=admin
JWT_SECRET=change-me-to-a-long-random-string
