# Copy this file to .env and fill in your values.
# MONGODB_URI and JWT_SECRET are required.

PORT=5000
MONGODB_URI=mongodb://<dbuser>:<password>@<shard-00-00>.<cluster>.mongodb.net:27017,<shard-00-01>.<cluster>.mongodb.net:27017,<shard-00-02>.<cluster>.mongodb.net:27017/<dbname>?retryWrites=true&w=majority&authSource=admin
JWT_SECRET=change-me-to-a-long-random-string

# Access tokens are short lived: every API request carries one. Clients renew
# them automatically with a refresh token, so an active user is never sent back
# to the login screen.
JWT_ACCESS_EXPIRES_IN=1h

# How long a login can be renewed before the user must log in again.
# Examples: 30d, 90d, 365d. Falls back to JWT_EXPIRES_IN when unset.
JWT_REFRESH_EXPIRES_IN=365d

# Optional. Signs refresh tokens. Falls back to JWT_SECRET when unset.
# Changing it logs every user out.
JWT_REFRESH_SECRET=

# Password-reset email (Gmail SMTP, free). Required for forgot-password OTP.
# 1. Use a Gmail address, e.g. fxwallet70@gmail.com
# 2. Google Account -> Security -> 2-Step Verification ON -> App passwords -> generate one
# 3. Paste the 16-char app password below (spaces are ignored).
SMTP_EMAIL=fxwallet70@gmail.com
SMTP_APP_PASSWORD=paste-your-16-char-app-password-here
SMTP_FROM=Nexora <fxwallet70@gmail.com>
